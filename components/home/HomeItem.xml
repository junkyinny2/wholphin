<?xml version="1.0" encoding="utf-8"?>
<component name="HomeItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" alwaysNotify="true" />
    <field id="posterUrl" type="string" value="" />
    <field id="itemTitle" type="string" value="" />
    <field id="itemType" type="string" value="" />
    <field id="watched" type="bool" value="false" />
    <field id="favorite" type="bool" value="false" />
  </interface>
  
  <children>
    <!-- Focus indicator (visible when item has focus) -->
    <Rectangle
      id="focusIndicator"
      translation="[-4, -4]"
      width="204"
      height="302"
      color="0x00A4DC00"
      blendColor="0x00A4DCFF"
      visible="false" />
    
    <!-- Item poster -->
    <Poster
      id="itemPoster"
      translation="[0, 0]"
      width="196"
      height="294"
      loadDisplayMode="scaleToFit" />
    
    <!-- Played indicator overlay -->
    <Rectangle
      id="playedCheckmark"
      translation="[164, 12]"
      width="24"
      height="24"
      color="0x1F9D55FF"
      visible="false" />

    <!-- Progress bar track (bottom of poster) -->
    <Rectangle
      id="progressTrack"
      translation="[0, 290]"
      width="196"
      height="4"
      color="0x40464EFF"
      visible="false" />

    <Rectangle
      id="progressFill"
      translation="[0, 290]"
      width="0"
      height="4"
      color="0x22D3EEFF"
      visible="false" />

    <!-- Favorite heart badge -->
    <Poster
      id="favoriteBadge"
      translation="[6, 10]"
      width="26"
      height="26"
      uri="pkg:/images/icons/nav_favorites.png"
      blendColor="0xFF4D6DFF"
      visible="false" />
    
    <!-- Item title -->
    <Label
      id="itemLabel"
      translation="[0, 298]"
      width="196"
      height="40"
      font="font:SmallSystemFont"
      color="0xFFFFFFFF"
      text=""
      wrap="true"
      vertAlign="top" />
  </children>
  
  <script type="text/brightscript" uri="pkg:/components/home/HomeItem.bs" />
</component>
