<?xml version="1.0" encoding="utf-8"?>
<component name="HomeItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" alwaysNotify="true" />
    <field id="posterUrl" type="string" value="" />
    <field id="itemTitle" type="string" value="" />
    <field id="itemType" type="string" value="" />
    <field id="watched" type="bool" value="false" />
    <field id="favorite" type="bool" value="false" />
  </interface>
  
  <children>
    <Rectangle
      id="focusIndicator"
      translation="[-4, -4]"
      width="204"
      height="302"
      color="0x2FD0FFFF"
      blendColor="0x2FD0FFFF"
      visible="false"
      focusable="false" />
    
    <Group id="posterContainer" clipRect="[0,0,196,294]">
      <Poster
        id="itemPoster"
        translation="[0, 0]"
        width="196"
        height="294"
        loadDisplayMode="scaleToZoom"
        focusable="false" />
    </Group>
    
    <Rectangle
      id="playedCheckmark"
      translation="[164, 12]"
      width="24"
      height="24"
      color="0x1F9D55FF"
      visible="false"
      focusable="false" />

    <Poster
      id="favoriteBadge"
      translation="[6, 10]"
      width="26"
      height="26"
      uri="pkg:/images/icons/nav_favorites.png"
      blendColor="0xFF4D6DFF"
      visible="false"
      focusable="false" />
    
    <Label
      id="itemLabel"
      translation="[0, 298]"
      width="196"
      height="40"
      font="font:SmallSystemFont"
      color="0xFFFFFFFF"
      text=""
      wrap="true"
      vertAlign="top" />
  </children>
  
  <script type="text/brightscript" uri="pkg:/components/home/HomeItem.bs" />
</component>
