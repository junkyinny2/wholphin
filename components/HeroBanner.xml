<?xml version="1.0" encoding="UTF-8"?>
<component name="HeroBanner" extends="Group" >
  <!-- Backdrop Image -->
  <Poster
    id="backdropImage"
    translation="[0, 0]"
    width="1920"
    height="400"
    uri="file://images/hero_backdrop.jpg"
    focusable="false"
  />
  
  <!-- Gradient Overlay -->
  <Rectangle
    id="gradientOverlay"
    translation="[0, 0]"
    width="1920"
    height="400"
    blendColor="0x88FFFFFF"
    opacity="0.5"
    focusable="false"
  />
  
  <!-- Title/Subtitle/Metadata/Description -->
  <Label
    id="titleLabel"
    translation="[100, 100]"
    text="Title"
    font="font:MediumBoldSystemFont"
  />
  <Label
    id="subtitleLabel"
    translation="[100, 150]"
    text="Subtitle"
    font="font:MediumSystemFont"
  />
  <Label
    id="metadataLabel"
    translation="[100, 200]"
    text="Metadata"
    font="font:MediumSystemFont"
  />
  <Label
    id="descriptionLabel"
    translation="[100, 250]"
    text="Description"
    font="font:MediumSystemFont"
  />
</component>