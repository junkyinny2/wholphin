' Wholphin Roku - Movie details screen logic

sub Init()
    m.port = CreateObject("roMessagePort")
    m.focusedBtnIdx = 0
    m.focusZone = -1   ' -1 = action buttons; 0+ = index into visible content grids
    m.handlingButtonSelected = false
    m.movieBackdrop = m.top.findNode("movieBackdrop")
    m.moviePoster = m.top.findNode("moviePoster")
    m.movieTitle = m.top.findNode("movieTitle")
    m.movieYear = m.top.findNode("movieYear")
    m.movieRuntime = m.top.findNode("movieRuntime")
    m.movieRating = m.top.findNode("movieRating")
    m.movieOverview = m.top.findNode("movieOverview")
    m.extrasGrid = m.top.findNode("extrasGrid")
    m.extrasLabel = m.top.findNode("extrasLabel")
    m.castGrid = m.top.findNode("castGrid")
    m.castLabel = m.top.findNode("castLabel")
    m.versionPanel = m.top.findNode("versionPanel")
    m.versionList = m.top.findNode("versionList")

    m.btnPlay = m.top.findNode("btnPlay")
    m.btnResume = m.top.findNode("btnResume")
    m.btnTrailer = m.top.findNode("btnTrailer")
    m.btnFavorite = m.top.findNode("btnFavorite")
    m.btnMyList = m.top.findNode("btnMyList")
    m.btnSubtitles = m.top.findNode("btnSubtitles")
    m.btnVersions = m.top.findNode("btnVersions")

    m.top.observeField("movie", "onMovieChange")
    m.top.observeField("metaData", "onMovieChange")
    m.btnPlay.observeField("buttonSelected", "onButtonSelected")
    m.btnResume.observeField("buttonSelected", "onButtonSelected")
    m.btnTrailer.observeField("buttonSelected", "onButtonSelected")
    m.btnFavorite.observeField("buttonSelected", "onButtonSelected")
    m.btnMyList.observeField("buttonSelected", "onButtonSelected")
    m.btnSubtitles.observeField("buttonSelected", "onButtonSelected")
    m.btnVersions.observeField("buttonSelected", "onButtonSelected")
    m.extrasGrid.observeField("itemSelected", "onExtrasItemSelected")
    m.castGrid.observeField("itemSelected", "onCastItemSelected")
    m.versionList.observeField("itemSelected", "onVersionSelected")
end sub

function onMovieChange() as Void
    LoadData()
end function

function OnScreenShown() as Boolean
    m.top.screenShown = true
    m.top.screenHidden = false
    setOverhangTitle(m.top.overhangTitle)
    print "[MovieDetails] OnScreenShown called"

    if m.lastFocusNode <> invalid then
        m.lastFocusNode.setFocus(true)
    else
        m.top.setFocus(true)
    end if

    if m.btnPlay <> invalid and m.btnPlay.visible then
        print "[MovieDetails] Setting focus to btnPlay"
        m.btnPlay.setFocus(true)
    end if
    return true
end function

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press then return false
    print "[MovieDetails] onKeyEvent: key="; key; " focusedBtnIdx="; m.focusedBtnIdx; " focusZone="; m.focusZone

    buttons = [m.btnPlay, m.btnResume, m.btnTrailer, m.btnFavorite, m.btnMyList, m.btnSubtitles, m.btnVersions]
    visibleButtons = []
    for each btn in buttons
        if btn <> invalid and btn.visible then visibleButtons.Push(btn)
    end for

    grids = visibleContentGrids()

    if key = "down" then
        if m.focusZone < grids.Count() - 1 then
            m.focusZone = m.focusZone + 1
            grids[m.focusZone].setFocus(true)
            return true
        end if
        return false
    else if key = "up" then
        if m.focusZone > -1 then
            m.focusZone = m.focusZone - 1
            if m.focusZone >= 0 and m.focusZone < grids.Count() then
                grids[m.focusZone].setFocus(true)
            else
                focusButton(visibleButtons)
            end if
            return true
        end if
        return false
    else if key = "left" then
        if m.focusZone = -1 then
            newIdx = (m.focusedBtnIdx - 1 + visibleButtons.Count()) MOD visibleButtons.Count()
            visibleButtons[newIdx].setFocus(true)
            m.focusedBtnIdx = newIdx
            return true
        end if
        return false
    else if key = "right" then
        if m.focusZone = -1 then
            newIdx = (m.focusedBtnIdx + 1) MOD visibleButtons.Count()
            visibleButtons[newIdx].setFocus(true)
            m.focusedBtnIdx = newIdx
            return true
        end if
        return false
    else if key = "back" then
        if m.focusZone > -1 then
            m.focusZone = -1
            focusButton(visibleButtons)
            return true
        end if
        PopCurrentScene()
        return true
    end if

    return false
end function

function visibleContentGrids() as Object
    grids = []
    if m.extrasGrid <> invalid and m.extrasGrid.visible then grids.Push(m.extrasGrid)
    if m.castGrid <> invalid and m.castGrid.visible then grids.Push(m.castGrid)
    return grids
end function

sub focusButton(visibleButtons as Object)
    if visibleButtons.Count() = 0 then return
    idx = m.focusedBtnIdx
    if idx < 0 or idx >= visibleButtons.Count() then idx = 0
    visibleButtons[idx].setFocus(true)
end sub

function LoadData() as Void
    m.top.loadingData = true
    m.top.overhangTitle = translateText("Movie Details")

    item = m.top.movie
    if item = invalid then return

    itemId = chainLookupReturn(item, ["id"], "")
    if itemId = "" then
        itemId = chainLookupReturn(item, ["Id"], "")
    end if
    if itemId = "" then return

    jsonData = chainLookupReturn(item, ["json"], {})
    if jsonData.Count() = 0 then
        jsonData = item
    end if

    title = chainLookupReturn(jsonData, ["Name"], "")
    m.movieTitle.text = title

    year = chainLookupReturn(jsonData, ["ProductionYear"], "")
    if year <> invalid then
        m.movieYear.text = year.ToStr()
    end if

    runtime = chainLookupReturn(jsonData, ["RunTimeTicks"], 0)
    if runtime > 0 then
        minutes = Int(runtime / 600000000)
        m.movieRuntime.text = minutes.ToStr() + " " + translateText("min")
    end if

    rating = chainLookupReturn(jsonData, ["CommunityRating"], 0)
    if rating <> invalid and rating > 0 then
        m.movieRating.text = "★ " + Str(rating).Trim()
    end if

    overview = chainLookupReturn(jsonData, ["Overview"], "")
    if overview <> invalid and overview <> "" then
        if Len(overview) > 500 then overview = Left(overview, 500) + "..."
        m.movieOverview.text = overview
    end if

    backdropUrl = BackdropImageURL(itemId)
    if backdropUrl <> "" then
        m.movieBackdrop.uri = backdropUrl
    end if

    posterImg = PosterImage(itemId, { maxHeight: 390, maxWidth: 260 })
    if posterImg <> invalid then
        m.moviePoster.uri = posterImg.url
    end if

    userData = chainLookupReturn(jsonData, ["UserData"], {})
    played = chainLookupReturn(userData, ["Played"], false)
    favorite = chainLookupReturn(userData, ["IsFavorite"], false)
    playbackPosition = chainLookupReturn(userData, ["PlaybackPositionTicks"], 0)

    m.top.isPlayed = played
    m.top.isFavorite = favorite

    if favorite then
        m.btnFavorite.buttonText = translateText("Favorited")
    else
        m.btnFavorite.buttonText = translateText("Favorite")
    end if

    if playbackPosition > 0 and not played then
        m.btnResume.visible = true
    else
        m.btnResume.visible = false
    end if

    loadCast(itemId)
    loadExtras(itemId)
    checkVersions(jsonData)

    m.focusedBtnIdx = 0
    m.btnResume.visible = (playbackPosition > 0 and not played)
    m.btnResume = m.btnResume

    m.top.loadingData = false
    m.top.dataLoaded = true
end function

function loadCast(itemId as String) as Void
    cast = chainLookupReturn(m.top.movie, ["json", "People"], [])
    ' Note: api.items.GetByID would call roUrlTransfer on the render thread which
    ' causes a crash. Use only the data already in m.top.movie, skip the API call.

    if cast <> invalid and cast.Count() > 0 then
        m.castLabel.visible = true
        content = CreateObject("roSGNode", "ContentNode")
        for each person in cast
            role = chainLookupReturn(person, ["Role"], "")
            if role = invalid then role = chainLookupReturn(person, ["Type"], "")
            child = content.CreateChild("ContentNode")
            child.id = chainLookupReturn(person, ["Id"], "")
            child.title = chainLookupReturn(person, ["Name"], "")
            child.role = role
            img = PosterImage(child.id, { maxHeight: 200, maxWidth: 150 })
            if img <> invalid then
                child.HDPosterUrl = img.url
            end if
        end for
        m.castGrid.content = content
        m.castGrid.visible = true
    else
        m.castLabel.visible = false ' Ensure label is hidden on failure/empty result
    end if
end function

function loadExtras(itemId as String) as Void
    ' Note: api.items.GetSpecialFeatures calls roUrlTransfer which is forbidden on render thread
    ' Use only data already in m.top.movie (special features are included in movie JSON)
    specials = chainLookupReturn(m.top.movie, ["json", "SpecialFeatures"], [])
    if specials = invalid or specials.Count() = 0 then
        m.extrasLabel.visible = false ' Ensure label is hidden on failure/empty result
        return
    end if

    m.extrasLabel.visible = true
    content = CreateObject("roSGNode", "ContentNode")
    for each special in specials
        child = content.CreateChild("ContentNode")
        child.id = chainLookupReturn(special, ["Id"], "")
        child.title = chainLookupReturn(special, ["Name"], "")
        child.type = chainLookupReturn(special, ["Type"], "")
        child.json = special
        img = PosterImage(child.id)
        if img <> invalid then
            child.HDPosterUrl = img.url
        end if
    end for
    m.extrasGrid.content = content
    m.extrasGrid.visible = true
end function

function checkVersions(jsonData as Object) as Void
    mediaSources = chainLookupReturn(jsonData, ["MediaSources"], [])
    if mediaSources = invalid then
        m.btnVersions.visible = false ' Hide button if data structure is missing entirely
        return
    end if

    if mediaSources.Count() > 1 then
        m.btnVersions.visible = true
        m.top.versions = mediaSources
    else
        m.btnVersions.visible = false ' Ensure button is hidden if only one source exists (or none)
    end if
end function

function onButtonSelected() as Void
    if m.handlingButtonSelected = true then return
    m.handlingButtonSelected = true

    print "[MovieDetails] onButtonSelected fired"
    btn = invalid

    candidates = [m.btnPlay, m.btnResume, m.btnTrailer, m.btnFavorite, m.btnMyList, m.btnSubtitles, m.btnVersions]
    for each candidate in candidates
        if candidate <> invalid and candidate.buttonSelected then
            btn = candidate
            candidate.buttonSelected = false
            print "[MovieDetails] Found button with buttonSelected=true: "; candidate.id
        end if
    end for

    if btn = invalid then
        m.handlingButtonSelected = false
        return
    end if

    btnText = btn.id

    if btnText = "btnPlay" then
        MainAction_Play(m.top.movie)
    else if btnText = "btnResume" then
        MainAction_Resume(m.top.movie)
    else if btnText = "btnTrailer" then
        itemId = chainLookupReturn(m.top.movie, ["id"], "")
        if itemId = "" then itemId = chainLookupReturn(m.top.movie, ["Id"], "")
        if itemId <> "" then MainAction_PlayTrailer(itemId)
    else if btnText = "btnFavorite" then
        itemId = chainLookupReturn(m.top.movie, ["id"], "")
        if itemId = "" then itemId = chainLookupReturn(m.top.movie, ["Id"], "")
        if itemId <> "" then
            MainAction_MarkFavorite(itemId, m.top.isFavorite)
            m.top.isFavorite = not m.top.isFavorite
            if m.top.isFavorite then
                m.btnFavorite.buttonText = translateText("Favorited")
            else
                m.btnFavorite.buttonText = translateText("Favorite")
            end if
        end if
    else if btnText = "btnMyList" then
        itemId = chainLookupReturn(m.top.movie, ["id"], "")
        if itemId = "" then itemId = chainLookupReturn(m.top.movie, ["Id"], "")
        if itemId <> "" then MainAction_AddToMyList(itemId)
    else if btnText = "btnSubtitles" then
        itemId = chainLookupReturn(m.top.movie, ["id"], "")
        if itemId = "" then itemId = chainLookupReturn(m.top.movie, ["Id"], "")
        if itemId <> "" then MainAction_EditSubtitles(itemId)
    else if btnText = "btnVersions" then
        toggleVersionPanel()
    end if

    m.handlingButtonSelected = false
end function

function toggleVersionPanel() as Void
    if m.versionPanel.visible then
        m.versionPanel.visible = false
        m.versionPanel.translation = [1920, 0]
    else
        versions = m.top.versions
        if versions = invalid or versions.Count() = 0 then return

        content = CreateObject("roSGNode", "ContentNode")
        for each version in versions
            child = content.CreateChild("ContentNode")
            child.title = chainLookupReturn(version, ["Name"], translateText("Unknown"))
            child.id = chainLookupReturn(version, ["Id"], "")
        end for
        m.versionList.content = content
        m.versionPanel.visible = true
        m.versionPanel.translation = [1520, 0]
        m.versionList.setFocus(true)
    end if
end function

function onVersionSelected() as Void
    focused = m.versionList.focusedItem
    if focused = invalid then return
    m.top.selectedVersion = focused.id
    toggleVersionPanel()
end function

function onExtrasItemSelected() as Void
    item = m.extrasGrid.focusedItem
    if item = invalid then return
    quickplay.video(item)
end function

function onCastItemSelected() as Void
    item = m.castGrid.focusedItem
    if item = invalid then return
    personData = {
        id:   item.id
        Name: item.title
        json: { Id: item.id, Name: item.title }
    }
    CreatePersonView(personData)
end function

function onBackPressed() as Boolean
    if m.versionPanel.visible then
        toggleVersionPanel()
        return true
    end if
    return false
end function

' --- Task Callbacks for Plan #1 Error Handling ---

sub onCastLoaded()
    m.top.statusMessage = translateText("Successfully loaded Cast data.")
end sub

sub onExtrasLoaded()
    m.top.statusMessage = translateText("Successfully loaded Extras/Special Features.")
end sub

sub onVersionsChecked()
    m.top.statusMessage = translateText("Successfully checked Media Source versions.")
end sub