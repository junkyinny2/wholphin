<?xml version="1.0" encoding="utf-8" ?>
<component name="RowListItem" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/RowListItem.brs" />

    <interface>
        <field id="itemContent" type="node" onChange="onContentSet" />
        <field id="width" type="float" onChange="onSizeChanged" />
        <field id="height" type="float" onChange="onSizeChanged" />
        <field id="rowListHasFocus" type="boolean" onChange="onFocusChanged" />
        <field id="rowFocusPercent" type="float" />
        <field id="rowListItemFocused" type="boolean" onChange="onFocusChanged" />
    </interface>

    <children>
        <Poster
            id="thumb"
            loadDisplayMode="scaleToFill"
        />

        <!-- Episode badge, top-right. Hidden for poster (2:3) items. -->
        <Rectangle id="episodeBadgeBg" width="34" height="24" color="0x000000AA" visible="false" />
        <Label id="episodeBadgeLabel" visible="false" font="font:SmallBoldSystemFont" color="0xFFFFFFFF" />

        <!-- Focus ring, drawn on top when this item has focus -->
        <Rectangle id="focusRing" color="0x14B4E8FF" visible="false" />
    </children>
</component>
