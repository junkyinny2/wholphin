<?xml version="1.0" encoding="utf-8" ?>
<component name="RowListItem" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/RowListItem.brs" />

    <interface>
        <field id="itemContent" type="node" onChange="onContentSet" />
        <field id="width" type="float" onChange="onSizeChanged" />
        <field id="height" type="float" onChange="onSizeChanged" />
        <field id="rowListHasFocus" type="boolean" onChange="onFocusChanged" />
        <field id="rowHasFocus" type="boolean" onChange="onFocusChanged" />
        <field id="itemHasFocus" type="boolean" onChange="onFocusChanged" />
        <field id="rowFocusPercent" type="float" />
    </interface>

    <children>
        <Group id="posterContainer">
          <Poster
            id="thumb"
            loadDisplayMode="scaleToZoom"
            focusable="false" />
          <Rectangle
            id="cornerMask"
            translation="[0,0]"
            width="196"
            height="294"
            color="0x00000000"
            focusable="false" />
        </Group>

        <Rectangle id="episodeBadgeBg" translation="[162, 6]" width="34" height="24" color="0x000000AA" visible="false" focusable="false" />
        <Label id="episodeBadgeLabel" visible="false" font="font:SmallBoldSystemFont" color="0xFFFFFFFF" />

        <Rectangle id="focusRing" color="0x2FD0FFFF" visible="false" opacity="0.8" focusable="false" />
    </children>
</component>
