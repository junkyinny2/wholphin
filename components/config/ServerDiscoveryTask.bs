sub Init()
    m.top.functionName = "discoverServers"
end sub

sub discoverServers()
    ? "[ServerDiscoveryTask] Starting..."
    m.top.loadStatus = "running"
    discovered = []

    ' Ports to scan (standard Jellyfin + custom)
    scanPorts = ["8096", "8097", "9086", "9100"]

    ' Quick scan: common hostnames + specific IPs
    quickIps = ["jellyfin", "jellyfin.local", "192.168.1.1", "192.168.1.10", "192.168.1.50", "192.168.1.196", "192.168.1.224"]
    for each ip in quickIps
        for each port in scanPorts
            url = "http://" + ip + ":" + port
            info = probeServer(url, 1000)
            if info <> invalid then
                ? "[ServerDiscoveryTask] FOUND: "; info.Name; " at "; info.Url
                discovered.Push(info)
            end if
        end for
    end for

    ' If not found yet, scan full subnet on all ports
    localIp = getLocalIP()
    ? "[ServerDiscoveryTask] Local IP = "; localIp
    if discovered.Count() = 0 and localIp <> "" then
        parts = localIp.Tokenize(".")
        if parts.Count() >= 3 then
            subnet = parts[0] + "." + parts[1] + "." + parts[2] + "."
            for each port in scanPorts
                if discovered.Count() > 0 then exit for
                ? "[ServerDiscoveryTask] Scanning subnet "; subnet; " on :"; port; "..."
                for i = 1 to 254
                    url = "http://" + subnet + i.ToStr() + ":" + port
                    info = probeServer(url, 400)
                    if info <> invalid then
                        ? "[ServerDiscoveryTask] FOUND: "; info.Name; " at "; info.Url
                        discovered.Push(info)
                    end if
                end for
            end for
        end if
    end if

    m.top.discoveredServers = discovered
    m.top.loadStatus = "done"
    ? "[ServerDiscoveryTask] Done. Found "; discovered.Count(); " servers"
end sub

function getLocalIP() as String
    deviceInfo = CreateObject("roDeviceInfo")
    addrs = deviceInfo.GetIPAddrs()
    if addrs = invalid then return ""
    for each iface in addrs
        ip = addrs[iface]
        if ip <> "" and ip <> "127.0.0.1" then return ip
    end for
    return ""
end function

function probeServer(url as String, timeoutMs as Integer) as Object
    baseUrl = url
    if Right(baseUrl, 1) = "/" then
        baseUrl = baseUrl.Left(Len(baseUrl) - 1)
    end if

    port = CreateObject("roMessagePort")
    req = CreateObject("roUrlTransfer")
    if req = invalid then return invalid

    req.SetMessagePort(port)
    req.SetUrl(baseUrl + "/System/Info/Public")
    req.InitClientCertificates()

    if req.AsyncGetToString() then
        resp = wait(timeoutMs, port)
        if Type(resp) = "roUrlEvent" and resp.GetResponseCode() = 200 then
            json = resp.GetString()
            info = ParseJson(json)
            if info <> invalid then
                productName = chainLookupReturn(info, ["ProductName"], "")
                if LCase(productName) = "jellyfin server" then
                    return {
                        Name: chainLookupReturn(info, ["ServerName"], "Jellyfin Server")
                        Url: baseUrl
                        Version: chainLookupReturn(info, ["Version"], "")
                        Id: chainLookupReturn(info, ["Id"], "")
                    }
                end if
            end if
        end if
    end if

    return invalid
end function
