sub Init()
    m.serverInputText = m.top.findNode("serverInputText")
    m.serverList = m.top.findNode("serverList")
    m.savedServersLabel = m.top.findNode("savedServersLabel")
    m.discoveredServerList = m.top.findNode("discoveredServerList")
    m.discoveredLabel = m.top.findNode("discoveredLabel")
    m.listSelectionBar = m.top.findNode("listSelectionBar")
    m.btnConnect = m.top.findNode("btnConnect")
    m.btnDiscover = m.top.findNode("btnDiscover")
    m.btnManualEntry = m.top.findNode("btnManualEntry")
    m.serverButtons = m.top.findNode("serverButtons")
    m.focusProxy = m.top.findNode("focusProxy")
    
    m.discoveredServerList.observeField("itemSelected", "onServerListItemSelected")
    m.discoveredServerList.observeField("itemFocused", "onServerListFocusChanged")
    m.serverList.observeField("itemSelected", "onSavedServerListItemSelected")
    
    m.keyboardDialog = invalid
    m.focusedButtonIndex = 0
    m.listIndex = 0
    m.isDiscovering = false
    
    m.top.observeField("savedServers", "onSavedServersChanged")
    populateSavedServers(m.top.savedServers)
    
    m.btnConnect.buttonText = "Connect"
    m.btnDiscover.buttonText = "Auto Discover"
    m.btnManualEntry.buttonText = "Manual Entry"
    
    m.btnConnect.observeField("buttonSelected", "onConnectPressed")
    m.btnDiscover.observeField("buttonSelected", "onDiscoverPressed")
    m.btnManualEntry.observeField("buttonSelected", "onManualEntryPressed")
    
    updateHighlights()
    m.top.observeField("visible", "onVisibleChange")
    
    ' Debug: write to temp file on device
    WriteAsciiFile("tmp:/setserver_debug.txt", "SetServer Init done. focusable=" + (m.top.focusable).ToStr() + " bgRect.focusable=" + (m.top.findNode("bgRect").focusable).ToStr())
end sub

function OnScreenShown() as Boolean
    m.top.screenShown = true
    m.top.screenHidden = false

    setOverhangTitle(m.top.overhangTitle)

    m.focusProxy.setFocus(true)
    WriteAsciiFile("tmp:/setserver_debug.txt", "OnScreenShown: focusProxy.focusable=" + (m.focusProxy.focusable).ToStr() + " focusProxy.hasFocus=" + (m.focusProxy.hasFocus()).ToStr())
    return true
end function

sub onVisibleChange()
    if m.top.visible then
        print "[SetServer] onVisibleChange: visible=true, calling updateHighlights"
        updateHighlights()
    end if
end sub

sub onConnectPressed()
    ConnectToServer()
end sub

sub onDiscoverPressed()
    StartDiscovery()
end sub

sub onManualEntryPressed()
    ShowKeyboard()
end sub

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press then return false

    ? "[SetServer] key="; key; " idx="; m.focusedButtonIndex
    WriteAsciiFile("tmp:/setserver_debug.txt", "onKeyEvent: key=" + key + " idx=" + m.focusedButtonIndex.ToStr() + " savedVis=" + (m.serverList.visible).ToStr() + " discVis=" + (m.discoveredServerList.visible).ToStr() + " fpHasFocus=" + (m.focusProxy.hasFocus()).ToStr())
    
    if key = "back" then
        if listIsActive() then
            m.focusedButtonIndex = 0
            scene = m.top.getScene()
            if scene <> invalid then
                scene.setField("pendingServerAction", "")
                scene.setField("pendingServerUrl", "")
            end if
            updateHighlights()
        else
            m.focusedButtonIndex = 0
            updateHighlights()
        end if
        return true
    end if
    
    if listIsActive() then
        lst = activeList()
        content = lst.content
        count = 0
        if content <> invalid then count = content.getChildCount()
        
        if key = "up" then
            if m.listIndex > 0 then
                m.listIndex = m.listIndex - 1
                lst.itemFocused = m.listIndex
                updateListSelection()
            else
                m.focusedButtonIndex = 0
                updateHighlights()
                m.listSelectionBar.visible = false
            end if
            return true
        else if key = "down" then
            if m.listIndex < count - 1 then
                m.listIndex = m.listIndex + 1
                lst.itemFocused = m.listIndex
                updateListSelection()
            end if
            return true
        else if key = "OK" then
            selectListItem(m.listIndex, lst)
            return true
        else if key = "left" then
            m.focusedButtonIndex = 0
            scene = m.top.getScene()
            if scene <> invalid then
                scene.setField("pendingServerAction", "")
                scene.setField("pendingServerUrl", "")
            end if
            updateHighlights()
            return true
		end if
		return false
	end if
    
    if key = "up" or key = "left" then
        m.focusedButtonIndex = (m.focusedButtonIndex - 1 + 3) MOD 3
        updateHighlights()
        return true
    else if key = "down" then
        if m.focusedButtonIndex = 0 and activeList() <> invalid then
            m.focusedButtonIndex = 3
            m.listIndex = 0
            activeList().itemFocused = 0
            m.listSelectionBar.visible = true
            updateHighlights()
            updateListSelection()
            return true
        end if
        m.focusedButtonIndex = (m.focusedButtonIndex + 1) MOD 3
        updateHighlights()
        return true
    else if key = "right" then
        if m.focusedButtonIndex < 3 then
            m.focusedButtonIndex = (m.focusedButtonIndex + 1) MOD 3
            updateHighlights()
            return true
        end if
    else if key = "OK" then
        ? "[SetServer] OK pressed, focusedButtonIndex="; m.focusedButtonIndex
        if m.focusedButtonIndex = 0 then
            ? "[SetServer] calling ConnectToServer"
            ConnectToServer()
        else if m.focusedButtonIndex = 1 then
            ? "[SetServer] calling StartDiscovery"
            StartDiscovery()
        else if m.focusedButtonIndex = 2 then
            ? "[SetServer] calling ShowKeyboard"
            ShowKeyboard()
        end if
        return true
    end if
    
    return false
end function

sub onServerListFocusChanged()
    focusedIdx = m.discoveredServerList.itemFocused
    if focusedIdx >= 0 then
        m.listIndex = focusedIdx
        updateListSelection()
    end if
end sub

sub onServerListItemSelected()
    selectListItem(m.discoveredServerList.itemSelected, m.discoveredServerList)
end sub

sub onSavedServerListItemSelected()
    selectListItem(m.serverList.itemSelected, m.serverList)
end sub

function activeList() as Object
    if m.serverList <> invalid and m.serverList.visible then return m.serverList
    if m.discoveredServerList <> invalid and m.discoveredServerList.visible then return m.discoveredServerList
    return invalid
end function

function listIsActive() as Boolean
    return (m.focusedButtonIndex = 3) and (activeList() <> invalid)
end function

sub onSavedServersChanged()
    populateSavedServers(m.top.savedServers)
end sub

sub populateSavedServers(servers as Object)
    if servers = invalid or servers.Count() = 0 then
        m.savedServersLabel.visible = false
        m.serverList.visible = false
        return
    end if
    content = CreateObject("roSGNode", "ContentNode")
    for each url in servers
        child = content.CreateChild("ContentNode")
        child.title = url
        child.url = url
    end for
    m.serverList.content = content
    m.savedServersLabel.visible = true
    m.serverList.visible = true
end sub

sub updateHighlights()
    print "[SetServer] updateHighlights: idx="; m.focusedButtonIndex; " savedVis="; m.serverList.visible; " discVis="; m.discoveredServerList.visible
    m.btnConnect.buttonFocused = (m.focusedButtonIndex = 0)
    m.btnDiscover.buttonFocused = (m.focusedButtonIndex = 1)
    m.btnManualEntry.buttonFocused = (m.focusedButtonIndex = 2)
    if m.focusedButtonIndex = 3 then
        lst = activeList()
        if lst <> invalid then lst.itemFocused = m.listIndex
    end if
    if m.focusProxy <> invalid then
        m.discoveredServerList.focusable = false
        m.serverList.focusable = false
        m.focusProxy.setFocus(true)
        print "[SetServer] updateHighlights: focus on focusProxy"
    else
        m.top.setFocus(true)
        print "[SetServer] updateHighlights: focus on screen"
    end if
end sub

sub updateListSelection()
    if m.discoveredServerList.visible or m.serverList.visible then
        y = 530 + (m.listIndex * 50)
        m.listSelectionBar.translation = [560, y]
    end if
end sub

sub ConnectToServer()
    url = m.serverInputText.text
    if url = "" then
        url = m.top.serverUrl
    end if
    ? "[SetServer] ConnectToServer: url='"; url; "'"
    if url = "" then
        ? "[SetServer] ConnectToServer: url empty, showing keyboard"
        ShowKeyboard()
        return
    end if
    scene = m.top.getScene()
    if scene <> invalid then
        ? "[SetServer] ConnectToServer: setting pendingServerAction=connect"
        scene.setField("pendingServerAction", "connect")
        scene.setField("pendingServerUrl", url)
    else
        ? "[SetServer] ConnectToServer: scene is INVALID!"
    end if
end sub

sub StartDiscovery()
    if m.isDiscovering then
        ? "[SetServer] StartDiscovery: already discovering"
        return
    end if
    ? "[SetServer] StartDiscovery: starting"
    m.isDiscovering = true
    m.top.isDiscovering = true
    if m.discoveryTask <> invalid then
        m.top.removeChild(m.discoveryTask)
    end if
    m.discoveryTask = CreateObject("roSGNode", "ServerDiscoveryTask")
    if m.discoveryTask = invalid then
        ? "[SetServer] StartDiscovery: FAILED to create ServerDiscoveryTask!"
        m.isDiscovering = false
        return
    end if
    m.discoveryTask.observeField("discoveredServers", "onDiscoveryComplete")
    m.discoveryTask.observeField("loadStatus", "onDiscoveryStatus")
    m.top.appendChild(m.discoveryTask)
    m.discoveryTask.control = "RUN"
    m.btnDiscover.buttonText = translateText("Searching...")
end sub

sub onDiscoveryStatus()
    status = m.discoveryTask.loadStatus
    if status = "done" then
        m.btnDiscover.buttonText = translateText("Auto Discover")
    end if
end sub

sub onDiscoveryComplete()
    m.isDiscovering = false
    m.top.isDiscovering = false
    m.btnDiscover.buttonText = translateText("Auto Discover")
    servers = m.discoveryTask.discoveredServers
    if servers = invalid or servers.Count() = 0 then
        show_dialog(translateText("No Servers Found"), translateText("No Jellyfin servers discovered on the network."))
        return
    end if
    m.discoveredLabel.visible = true
    m.discoveredServerList.visible = true
    m.listSelectionBar.visible = true
    m.discoveredServerList.content = createDiscoveryContent(servers)
    m.savedServersLabel.visible = false
    m.serverList.visible = false
    m.discoveredServerList.itemFocused = 0
    m.listIndex = 0
    m.focusedButtonIndex = 3
    updateHighlights()
    updateListSelection()
end sub

function createDiscoveryContent(servers as Object) as Object
    content = CreateObject("roSGNode", "ContentNode")
    for each server in servers
        child = content.CreateChild("ContentNode")
        child.title = chainLookupReturn(server, ["Name"], "")
        child.url = chainLookupReturn(server, ["Url"], "")
        child.id = chainLookupReturn(server, ["Id"], "")
    end for
    return content
end function

sub selectListItem(index as Integer, lst as Object)
    if lst = invalid then
        return
    end if
    content = lst.content
    if content = invalid then
        return
    end if
    item = content.getChild(index)
    if item = invalid then
        return
    end if
    url = item.url
    if url <> "" then
        scene = m.top.getScene()
        if scene <> invalid then
            scene.setField("pendingServerAction", "connect")
            scene.setField("pendingServerUrl", url)
        end if
    end if
end sub

sub ShowKeyboard()
    ? "[SetServer] ShowKeyboard: creating KeyboardDialog"
    keyboard = CreateObject("roSGNode", "KeyboardDialog")
    if keyboard = invalid then
        ? "[SetServer] ShowKeyboard: FAILED to create KeyboardDialog!"
        return
    end if
    keyboard.title = translateText("Enter Server URL")
    keyboard.text = m.serverInputText.text
    keyboard.buttons = [translateText("OK"), translateText("Cancel")]
    
    m.keyboardDialog = keyboard
    
    keyboard.observeField("buttonSelected", "onKeyboardButton")
    keyboard.id = "KeyboardDialog"
    
    scene = m.top.getScene()
    ? "[SetServer] ShowKeyboard: scene.valid="; (scene <> invalid)
    if scene <> invalid and scene.HasField("dialog") then
        scene.dialog = keyboard
        ? "[SetServer] ShowKeyboard: dialog set"
        ' Force focus to the keyboard dialog's keyboard child so key events go to it
        if keyboard.HasField("keyboard") then
            kb = keyboard.keyboard
            if kb <> invalid then kb.setFocus(true)
        end if
        if keyboard.HasField("content") then
            c = keyboard.content
            if c <> invalid then c.setFocus(true)
        end if
        keyboard.setFocus(true)
        ? "[SetServer] ShowKeyboard: focus set on keyboard"
    end if
end sub

sub onKeyboardButton()
    ? "[SetServer] onKeyboardButton: called"
    scene = m.top.getScene()
    if scene = invalid then return
    dialog = scene.dialog
    if dialog = invalid then return
    btnIndex = dialog.buttonSelected
    url = dialog.text
    ? "[SetServer] onKeyboardButton: btnIndex=" + btnIndex.ToStr() + " url=" + url
    scene.dialog = invalid
    m.focusProxy.setFocus(true)
    if btnIndex = 0 and url <> "" then
        ? "[SetServer] onKeyboardButton: setting pendingServerAction=connect"
        scene.setField("pendingServerUrl", url)
        scene.setField("pendingServerAction", "connect")
    end if
end sub

function onBackPressed() as Boolean
    return false
end function