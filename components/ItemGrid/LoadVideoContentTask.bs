' Wholphin Roku - Async task for loading video playback content

Library "pkg:/source/api/Items.bs"
Library "pkg:/source/api/userauth.bs"

sub Init()
    m.top.functionName = "loadVideoContent"
end sub

sub loadVideoContent()
    print "[VCTASK] loadVideoContent START itemId="; m.top.itemId
    itemId = m.top.itemId
    if itemId = "" then
        m.top.loadStatus = "error"
        return
    end if

    mediaSourceId = m.top.mediaSourceId
    audioStreamIndex = m.top.audioStreamIndex
    subtitleStreamIndex = m.top.subtitleStreamIndex
    startTimeTicks = m.top.startTimeTicks

    playbackInfo = ItemPostPlaybackInfo(itemId, mediaSourceId, audioStreamIndex, subtitleStreamIndex, startTimeTicks)
    if playbackInfo = invalid then
        print "[VCTASK] ItemPostPlaybackInfo returned invalid, lastNetworkError="; m.global.lastNetworkError
        m.top.loadStatus = "error"
        return
    end if
    print "[VCTASK] ItemPostPlaybackInfo valid, MediaSources="; chainLookupReturn(playbackInfo, ["MediaSources"], []).Count()

    mediaSources = chainLookupReturn(playbackInfo, ["MediaSources"], [])
    if mediaSources = invalid or mediaSources.Count() = 0 then
        mediaSources = chainLookupReturn(playbackInfo, ["MediaSource"], [])
    end if
    if mediaSources = invalid or mediaSources.Count() = 0 then
        m.top.loadStatus = "error"
        return
    end if

    mediaSource = mediaSources[0]
    if mediaSourceId <> "" then
        for each ms in mediaSources
            if chainLookupReturn(ms, ["Id"], "") = mediaSourceId then
                mediaSource = ms
                exit for
            end if
        end for
    end if

    m.top.playSessionId = chainLookupReturn(playbackInfo, ["PlaySessionId"], "")

    mediaUrl = chainLookupReturn(mediaSource, ["DirectStreamUrl"], "")
    if mediaUrl = "" then
        mediaUrl = chainLookupReturn(mediaSource, ["TranscodingUrl"], "")
        if mediaUrl <> "" then container = "mp4"
    end if

    if mediaUrl <> "" then
        serverUrl = session.server.GetUrl()
        if mediaUrl.StartsWith("http") = false then
            mediaUrl = serverUrl + mediaUrl
        end if
        if container = "" then
            containerParts = chainLookupReturn(mediaSource, ["Container"], "").Split(",")
            if containerParts.Count() > 0 then container = containerParts[0].Trim()
        end if
    end if

    if mediaUrl = "" then
        mediaSourceId = chainLookupReturn(mediaSource, ["Id"], "")
        container = chainLookupReturn(mediaSource, ["Container"], "")
        containerParts = container.Split(",")
        container = ""
        for each part in containerParts
            test = part.Trim()
            if test = "mp4" or test = "mkv" or test = "webm" or test = "hls" then
                container = test
                exit for
            end if
        end for
        if container = "" then
            if containerParts.Count() > 0 and containerParts[0] <> "" then
                container = containerParts[0]
            else
                container = "mp4"
            end if
        end if
        if container = "hls" then container = "mp4"
        token = chainLookupReturn(m.global.session.user, ["accessToken"], "")
        serverUrl = session.server.GetUrl()
        streamRel = "/Videos/" + itemId + "/stream?Static=true&Container=" + container
        if token <> "" then streamRel = streamRel + "&api_key=" + token
        mediaUrl = serverUrl + streamRel
    end if

    if mediaUrl = "" then
        print "[VCTASK] mediaUrl EMPTY after all sources"
        m.top.loadStatus = "error"
        return
    end if
    print "[VCTASK] mediaUrl set, primaryContainer="; container; " playMethod="; chainLookupReturn(mediaSource, ["PlayMethod"], "")

    m.top.mediaSourceIdOut = chainLookupReturn(mediaSource, ["Id"], "")
    m.top.playMethod = chainLookupReturn(mediaSource, ["PlayMethod"], "")

    chapters = chainLookupReturn(mediaSource, ["Chapters"], [])
    if chapters.Count() = 0 then
        chapters = chainLookupReturn(playbackInfo, ["Chapters"], [])
    end if
    m.top.chapters = chapters

    content = CreateObject("roSGNode", "ContentNode")
    content.url = mediaUrl
    content.streamformat = container

    ' The Video node manages audio/subtitle tracks natively via m.video.audioTrack /
    ' m.video.subtitleTrack. Do NOT set ContentNode.AudioTracks/SubtitleTracks/Streams
    ' with raw Jellyfin associative arrays - those fields are not valid on a ContentNode
    ' and corrupt it, causing a fatal mediaplayer error (mediaplayer:6).

    print "[VCTASK] setting m.top.content, url="; content.url; " format="; content.streamformat

    m.top.content = content
    m.top.loadStatus = "loaded"
end sub
