    <field id="selectedIndex" type="int" value="0" alwaysNotify="true" />
    <field id="navItems" type="array" />
    <field id="onItemSelected" type="string" value="" alwaysNotify="true" />
  </interface>

  <children>
    <Rectangle
      id="navBg"
      width="80"
      height="1080"
      color="0x0A0E14BB" />

    <Group id="navItemsGroup" translation="[0, 80]" />

    <Rectangle
      id="activeIndicator"
      width="3"
      height="36"
      color="0x22D3EEFF"
      translation="[77, 90]"
      opacity="0" />
  </children>

  <script type="text/brightscript" uri="pkg:/components/LeftNavRail.brs" />
</component>
