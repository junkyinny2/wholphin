sub init()
    m.sectionTabs = m.top.findNode("sectionTabs")
    m.itemGrid = m.top.findNode("itemGrid")
    m.pageTitle = m.top.findNode("pageTitle")

    m.top.observeField("items", "onItemsChanged")
    m.sectionTabs.setFocus(true)
end sub

function translateText(text as String) as String
    return text
end function

sub onItemsChanged()
    items = m.top.items
    if items = invalid then return
    content = CreateObject("roSGNode", "ContentNode")
    for each item in items
        child = content.CreateChild("ContentNode")
        child.id = item.Id
        child.title = item.Name
        child.hdPosterUrl = item.ImageUrl
    end for
    m.itemGrid.content = content
end sub

function onKeyEvent(key as String, press as Boolean) as Boolean
    if not press then return false
    return false
end function
