<?xml version="1.0" encoding="utf-8" ?>
<component name="NavRail" extends="Group" focusable="true">
    <script type="text/brightscript" uri="pkg:/components/NavRail.brs" />

    <interface>
        <field id="itemSelected" type="string" alwaysNotify="true" />
    </interface>

    <children>
        <Rectangle
            id="railBackground"
            width="90"
            height="1080"
            color="0x0E1220E8"
            focusable="false"
        />

        <!-- Dynamic icon stack (profile/search/home/favorites/discover/libraries/settings) -->
        <Group id="itemStack" translation="[0, 112]" />

        <Poster
            id="railLogo"
            translation="[15, 24]"
            width="60"
            height="60"
            uri="pkg:/images/mm_icon_focus_fhd.png"
            focusable="false" />
    </children>
</component>
