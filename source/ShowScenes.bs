function _sm() as Object
    ' Try getGlobalAA() first
    gaa = getGlobalAA()
    if gaa <> invalid and gaa.sceneManager <> invalid then return gaa.sceneManager

    ' Try m.global
    if m <> invalid and m.global <> invalid and m.global.sceneManager <> invalid then
        return m.global.sceneManager
    end if

    ' Try finding SceneManager via the scene graph
    if m <> invalid then
        if m.top <> invalid then
            scene = m.top.getScene()
            if scene <> invalid then
                sm = scene.findNode("SceneManager")
                if sm <> invalid then
                    print "[V35-DEBUG] _sm: found via scene.findNode(" + Chr(34) + "SceneManager" + Chr(34) + ")"
                    return sm
                end if
                if scene.HasField("sceneManager") and scene.sceneManager <> invalid then
                    print "[V35-DEBUG] _sm: found via scene.sceneManager field"
                    return scene.sceneManager
                end if
                content = scene.findNode("content")
                if content <> invalid then
                    sm = content.findNode("SceneManager")
                    if sm <> invalid then
                        print "[V35-DEBUG] _sm: found via content.findNode"
                        return sm
                    end if
                end if
            end if
        end if
    end if

    ? "[V35-DEBUG] _sm: FAILED to find sceneManager via all methods"
    ? "[V35-DEBUG] _sm: m.invalid="; (m = invalid)
    if m <> invalid then
        ? "[V35-DEBUG] _sm: m.global.invalid="; (m.global = invalid)
        if m.global <> invalid then
            ? "[V35-DEBUG] _sm: m.global.sceneManager.invalid="; (m.global.sceneManager = invalid)
        end if
    end if
    return invalid
end function

sub PushScene(screenNode as Object)
    sm = _sm()
    if sm = invalid then
        print "[V35-DEBUG] PushScene: sm is INVALID, cannot push!"
        ' Last resort: find SceneManager through the screen
        gaa = getGlobalAA()
        if gaa <> invalid and gaa.scene <> invalid then
            scene = gaa.scene
            sm = scene.findNode("SceneManager")
            if sm = invalid then
                sm = scene.sceneManager
            end if
        end if
        if sm = invalid then
            print "[V35-DEBUG] PushScene: FALLBACK also failed!"
            return
        end if
        print "[V35-DEBUG] PushScene: found SceneManager via fallback"
    else
        print "[V35-DEBUG] PushScene: sm=" + sm.Subtype() + " calling pushScene"
    end if
    result = sm.callFunc("pushScene", screenNode)
    print "[V35-DEBUG] PushScene: callFunc returned " + result.ToStr()
end sub

' Pop current scene from stack without callFunc (avoids Void→sub hang on this firmware).
' IMPORTANT: the actual scene-graph surgery (visible=true on the re-shown scene,
' removeChild of the popped scene) is DEFERRED to a one-shot Timer. Doing those
' synchronously inside an onKeyEvent handler stalls the render thread when the
' re-shown scene is a large tree like HomeScreen (see AGENTS.md §4.5).
function PopCurrentScene() as Boolean
    sm = _sm()
    if sm = invalid then return false
    stack = sm.sceneStack
    if stack = invalid or stack.Count() = 0 then return false
    gaa = getGlobalAA()
    if gaa <> invalid and gaa.__pendingPop <> invalid then
        ' A pop is already in flight (its deferred timer hasn't fired yet).
        ' Queue this one instead of swallowing the user's key.
        if gaa <> invalid then gaa.__queuedPop = true
        ? "[POP] queued pop (stack="; stack.Count(); ")"
        return true
    end if
    sceneToRemove = stack.Pop()
    sm.sceneStack = stack
    sm.sceneCount = stack.Count()
    if stack.Count() = 0 then
        sm.activeScene = invalid
        if sceneToRemove <> invalid then sceneToRemove.visible = false
        return true
    end if
    previousScene = stack.Peek()
    sm.activeScene = previousScene
    if previousScene.Subtype() = "JFScreen" or previousScene.HasField("screenShown") then
        previousScene.screenShown = true
        previousScene.screenHidden = false
    end if
    if gaa <> invalid then
        gaa.__pendingPop = { previousScene: previousScene, sceneToRemove: sceneToRemove, sm: sm }
    end if
    ? "[POP] pop "; sceneToRemove.Subtype(); " re-show "; previousScene.Subtype(); " stack="; stack.Count()
    timer = sm.createChild("Timer")
    timer.id = "pendingPopTimer"
    timer.duration = 0
    timer.repeat = false
    timer.observeField("fire", "onPendingPopFired")
    timer.control = "start"
    return true
end function

sub onPendingPopFired()
    ? "[POP-FIRED] start"
    gaa = getGlobalAA()
    data = invalid
    if gaa <> invalid then
        data = gaa.__pendingPop
        gaa.__pendingPop = invalid
    end if
    if data = invalid then return
    previousScene = data.previousScene
    sceneToRemove = data.sceneToRemove
    sm = data.sm
    if sm <> invalid then
        timer = sm.findNode("pendingPopTimer")
        if timer <> invalid then
            timer.control = "stop"
            sm.removeChild(timer)
        end if
    end if
    if previousScene = invalid then return
    previousScene.visible = true
    if previousScene.Subtype() = "JFScreen" then
        previousScene.callFunc("OnScreenShown")
    else if previousScene.HasField("OnScreenShown") then
        previousScene.callFunc("OnScreenShown")
    end if
    ' Only touch focus if the previous scene has no valid focusedChild:
    ' re-setFocus-ing a subtree that already holds focus deadlocks too.
    if previousScene.focusedChild = invalid then
        homeRows = previousScene.findNode("homeRows")
        if homeRows <> invalid then
            homeRows.setFocus(true)
        else
            previousScene.setFocus(true)
        end if
    end if
    if sceneToRemove <> invalid then
        baseScene = sm.getScene()
        if baseScene <> invalid then
            content = baseScene.findNode("content")
            if content <> invalid and sceneToRemove.parent = content then
                content.removeChild(sceneToRemove)
            else
                sceneToRemove.visible = false
            end if
        end if
    end if
    ? "[POP-FIRED] end"
    ' Process a pop that arrived while this one was in flight.
    if gaa <> invalid and gaa.__queuedPop = true then
        gaa.__queuedPop = false
        PopCurrentScene()
    end if
end sub

function ClearAllScenes() as Boolean
    sm = _sm()
    if sm = invalid then return false
    stack = sm.sceneStack
    if stack = invalid or stack.Count() = 0 then
        sm.sceneStack = []
        sm.sceneCount = 0
        sm.activeScene = invalid
        return true
    end if
    baseScene = sm.getScene()
    content = invalid
    if baseScene <> invalid then content = baseScene.findNode("content")
    for each scene in stack
        if content <> invalid and scene <> invalid and scene.parent = content then
            content.removeChild(scene)
        else if scene <> invalid then
            scene.visible = false
        end if
    end for
    sm.sceneStack = []
    sm.sceneCount = 0
    sm.activeScene = invalid
    gaa = getGlobalAA()
    if gaa <> invalid then
        gaa.__pendingPop = invalid
        gaa.__queuedPop = false
    end if
    return true
end function

function LoginFlow() as Boolean
    savedServer = get_setting("server", "")
    
    if savedServer <> "" then
        session.server.Populate({ Url: savedServer })
        serverData = ServerInfo()
        if serverData <> invalid then
            session.server.Populate({
                Id:       chainLookupReturn(serverData, ["Id"], "")
                ServerName: chainLookupReturn(serverData, ["Name"], "")
                Url:      savedServer
                Version:  chainLookupReturn(serverData, ["Version"], "")
            })
        else
            savedServer = ""
        end if
    end if
    
    ' If no server configured, show server entry screen and RETURN
    if savedServer = "" then
        CreateServerGroup()
        return false
    end if
    
    ' Check for saved user
    lastUserId = get_setting("last_userId", "")
    savedToken = ""
    if lastUserId <> "" then
        savedToken = get_user_setting(lastUserId, "accessToken", "")
    end if
    
    if savedToken <> "" then
        set_setting("server", session.server.GetUrl())
        session.user.Populate({ AccessToken: savedToken, User: { Id: lastUserId } })
        
        myInfo = AboutMe()
        if myInfo <> invalid then
            session.user.UpdateFromAboutMe(myInfo)
            caps = getDeviceCapabilities()
            api.sessions.PostCapabilities(caps)
            return true
        else
            savedToken = ""
            session.user.Clear()
        end if
    end if
    
    ShowLoginScreen()
    return false
end function

function ShowLoginScreen() as Boolean
    publicUsers = GetPublicUsers()
    
    quickConnectEnabled = false
    
    sm = _sm()
    scene = sm.getScene()
    if scene = invalid then
        return false
    end if
    userSelect = scene.findNode("userSelect")
    if userSelect = invalid then
        return false
    end if
    userSelect.users = publicUsers
    userSelect.quickConnectEnabled = quickConnectEnabled
    
    serverScreen = scene.findNode("serverScreen")
    if serverScreen <> invalid then serverScreen.visible = false
    userSelect.visible = true
    
    sm.callFunc("pushScene", userSelect)
    
    userRow = userSelect.findNode("userRow")
    if userRow <> invalid then
        grid = userRow.findNode("userGrid")
        if grid <> invalid then
            grid.setFocus(true)
        else
            userSelect.setFocus(true)
        end if
    else
        userSelect.setFocus(true)
    end if
    
    return true
end function

function ProcessUserSelection(userData as Object) as Boolean
    username = chainLookupReturn(userData, ["Name"], "")
    userId = chainLookupReturn(userData, ["Id"], "")
    hasPassword = chainLookupReturn(userData, ["HasPassword"], true)
    isPublic = chainLookupReturn(userData, ["IsPublic"], false)
    
    if username = "" then return false
    
    savedPw = get_user_setting(userId, "password", "")
    
    if isPublic and not hasPassword then
        return AuthenticateUser(username, "")
    else if savedPw <> "" then
        return AuthenticateUser(username, savedPw)
    else
        return ShowSignInScreen(username)
    end if
end function

function ShowSignInScreen(username as String) as Boolean
    sm = _sm()
    if sm = invalid then return false
    scene = sm.getScene()
    if scene = invalid then return false
    signIn = scene.findNode("signinScene")
    if signIn = invalid then return false
    signIn.username = username
    signIn.visible = true
    userSelect = scene.findNode("userSelect")
    if userSelect <> invalid then userSelect.visible = false
    sm.callFunc("pushScene", signIn)
    signIn.setFocus(true)
    return true
end function

function AuthenticateUser(username as String, password as String) as Boolean
    authResult = get_token(username, password)
    if authResult = invalid then return false
    
    accessToken = chainLookupReturn(authResult, ["AccessToken"], "")
    if accessToken = "" then return false
    
    session.user.Populate(authResult)
    
    userId = chainLookupReturn(authResult, ["User", "Id"], "")
    if userId <> "" then
        set_user_setting(userId, "accessToken", accessToken)
        set_setting("last_userId", userId)
    end if
    
    set_setting("server", session.server.GetUrl())
    saveServer(session.server.GetUrl())
    
    caps = getDeviceCapabilities()
    api.sessions.PostCapabilities(caps)
    
    myInfo = AboutMe()
    if myInfo <> invalid then
        session.user.UpdateFromAboutMe(myInfo)
    end if
    
    return true
end function

function CreateServerGroup() as Boolean
    print "[V35-DEBUG] CreateServerGroup called"
    sm = _sm()
    if sm = invalid then
        print "[V35-DEBUG] CreateServerGroup: _sm() INVALID"
        return false
    end if
    baseScene = sm.getScene()
    if baseScene = invalid then
        return false
    end if
    serverScreen = baseScene.findNode("serverScreen")
    if serverScreen = invalid then
        return false
    end if
    serverScreen.savedServers = getSavedServers()
    serverScreen.visible = true
    
    sm.callFunc("pushScene", serverScreen)
    
    return true
end function

function ProcessServerUrl(serverUrl as String) as Boolean
    if serverUrl = "" then return false
    
    if Left(serverUrl, 4) <> "http" then
        serverUrl = inferServerUrl(serverUrl)
    end if
    
    if Right(serverUrl, 1) = "/" then
        serverUrl = serverUrl.Left(Len(serverUrl) - 1)
    end if
    
    session.server.Populate({ Url: serverUrl })
    serverData = ServerInfo()
    if serverData = invalid then
        show_dialog(translateText("Connection Failed"), translateText("Unable to connect to server. Please check the URL and try again."))
        session.server.Clear()
        return false
    end if
    
    version = chainLookupReturn(serverData, ["Version"], "")
    if not serverVersionMeetsMinimumRequirements(version) then
        show_dialog(translateText("Unsupported Server Version"), translateText("This server version is not supported. Please upgrade to Jellyfin 10.8 or later."))
        session.server.Clear()
        return false
    end if
    
    session.server.Populate({
        Id:       chainLookupReturn(serverData, ["Id"], "")
        ServerName: chainLookupReturn(serverData, ["Name"], "")
        Url:      serverUrl
        Version:  version
        OperatingSystem: chainLookupReturn(serverData, ["OperatingSystem"], "")
    })
    
    set_setting("server", serverUrl)
    saveServer(serverUrl)
    
    return true
end function

function CreateHomeGroup() as Object
    print "[V35-DEBUG] CreateHomeGroup: creating HomeScreen node"

    ' Hide login/setup screens - they sit ABOVE the content group in BaseScene z-order
    ' and would otherwise stay visible on top of Home, stealing the view (AGENTS.md §4.4)
    sm = _sm()
    if sm <> invalid then
        baseScene = sm.getScene()
        if baseScene <> invalid then
            ss = baseScene.findNode("serverScreen")
            if ss <> invalid then ss.visible = false
            us = baseScene.findNode("userSelect")
            if us <> invalid then us.visible = false
            si = baseScene.findNode("signinScene")
            if si <> invalid then si.visible = false
        end if
    end if

    home = CreateObject("roSGNode", "HomeScreen")
    if home = invalid then
        print "[V35-DEBUG] CreateHomeGroup: FAILED to create HomeScreen!"
        return invalid
    end if
    PushScene(home)
    print "[V35-DEBUG] CreateHomeGroup: PushScene called"
    return home
end function

function CreateMovieDetailsGroup(movie as Object, preloadedMetadata = invalid as Dynamic) as Object
    print "[V35-DEBUG] CreateMovieDetailsGroup: creating MovieDetails"
    details = CreateObject("roSGNode", "MovieDetails")
    if details = invalid then
        print "[V35-DEBUG] CreateMovieDetailsGroup: FAILED!"
        return invalid
    end if
    details.movie = movie
    
    if preloadedMetadata <> invalid then
        details.metaData = preloadedMetadata
    end if
    
    PushScene(details)
    return details
end function

function CreateSeriesDetailsGroup(seriesId as String) as Object
    series = CreateObject("roSGNode", "TVSeriesDetails")
    series.id = seriesId
    PushScene(series)
    return series
end function

function CreateSeasonDetailsGroup(series as Object, season as Object) as Object
    seasonDetails = CreateObject("roSGNode", "TVSeasonDetails")
    seasonDetails.seriesData = series
    seasonDetails.seasonData = season
    PushScene(seasonDetails)
    return seasonDetails
end function

