' Wholphin Roku - Device capabilities and Jellyfin device profile generation

' Get device capabilities for Jellyfin
function getDeviceCapabilities() as Object
    di = CreateObject("roDeviceInfo")
    
    capabilities = {
        PlayableMediaTypes: ["Audio", "Video"]
        SupportedCommands:  ["MoveUp", "MoveDown", "MoveLeft", "MoveRight", "PageUp", "PageDown",
                            "Select", "Back", "TogglePlayPause", "Play", "Pause", "Stop",
                            "FastForward", "Rewind", "Seek", "SetRepeatMode", "SetShuffleQueue",
                            "SetAudioStreamIndex", "SetSubtitleStreamIndex", "ToggleFullscreen",
                            "SetVolume", "Mute", "Unmute", "ToggleMute"]
        SupportsMediaControl: true
        SupportsContentUploading: false
        SupportsPersistentIdentifier: true
        SupportsSync: false
    }
    
    return capabilities
end function

' Generate the full device profile for Jellyfin playback info requests
function getDeviceProfile() as Object
    di = CreateObject("roDeviceInfo")
    
    ' Determine max supported bitrate based on device capabilities
    bitrate = 40000000 ' 40 Mbps default

    ' Get user bitrate setting (stored in bps, e.g. 200000000 = 200 Mbps)
    userBitrate = session.user.GetSetting("playback.bitrate", "")
    if userBitrate <> "" then
        parsedBitrate = Val(userBitrate)
        if parsedBitrate > 0 then bitrate = parsedBitrate
    end if

    ' Jellyfin DeviceProfile.MaxStreamingBitrate/MaxStaticBitrate are Int32;
    ' clamp to keep the profile valid and avoid overflow rejection.
    if bitrate > 120000000 then bitrate = 120000000
    
    profile = {
        Name:             "Wholphin Roku"
        MaxStreamingBitrate: bitrate
        MaxStaticBitrate:     bitrate
        MusicStreamingTranscodingBitrate: 320000
        DirectPlayProfiles:  GetDirectPlayProfiles()
        TranscodingProfiles: GetTranscodingProfiles(bitrate)
        ContainerProfiles:   []
        CodecProfiles:       GetCodecProfiles()
        SubtitleProfiles:    GetSubtitleProfiles()
        ResponseProfiles:    []
    }
    
    return profile
end function

' Get DirectPlay profiles supported by Roku
function GetDirectPlayProfiles() as Object
    di = CreateObject("roDeviceInfo")
    profiles = []

    videoContainers = ["mp4", "mkv", "ts", "mov", "m4v", "wmv", "asf", "avi", "mts", "m2ts"]
    ' NOTE: exclude hevc/h265. CanDecodeVideo may report HEVC support on some Roku
    ' models, but HEVC playback reliably fails at runtime (state=error). Forcing
    ' Jellyfin to transcode HEVC -> h264 is the only dependable path.
    videoCodecs = ["h264", "mpeg4", "mpeg2video", "vc1"]
    audioCodecs = ["aac", "mp3", "mp2", "ac3", "eac3", "dts", "dca", "wma", "wmapro", "pcm_s16le", "truehd"]

    for each container in videoContainers
        codecs = ""
        for each codec in videoCodecs
            if di.CanDecodeVideo({ Codec: codec, Container: container }).Result then
                if codecs <> "" then codecs = codecs + ","
                codecs = codecs + codec
            end if
        end for
        if codecs <> "" then
            profiles.Push({
                Container:  container
                Type:       "Video"
                VideoCodec: codecs
                AudioCodec: ""
            })
        end if
    end for

    audioContainers = ["mp3", "wma", "wav", "ogg", "oga", "flac", "aac", "m4a", "m4b", "opus"]
    for each container in audioContainers
        profiles.Push({
            Container:  container
            Type:       "Audio"
            VideoCodec: ""
            AudioCodec: ""
        })
    end for

    photoContainers = ["jpg", "jpeg", "png", "gif", "bmp", "webp"]
    for each container in photoContainers
        profiles.Push({
            Container:  container
            Type:       "Photo"
            VideoCodec: ""
            AudioCodec: ""
        })
    end for

    return profiles
end function

' Get transcoding profiles
function GetTranscodingProfiles(bitrate as Integer) as Object
    profiles = []
    
    ' HLS audio transcoding
    profiles.Push({
        Container:       "ts"
        Type:            "Audio"
        AudioCodec:      "aac"
        VideoCodec:      ""
        Protocol:        "hls"
        EstimateContentLength: false
        MinSegments:     2
        SegmentLength:   0
        BreakOnNonKeyFrames: true
        Context:         "Streaming"
        MaxAudioChannels: 2
        TranscodeSeekInfo: "Auto"
        CopyTimestamps:  false
    })
    
    ' MP4 HTTP video transcoding (works with Roku Video node; output must be h264 since Roku cannot decode HEVC)
    profiles.Push({
        Container:       "mp4"
        Type:            "Video"
        AudioCodec:      "aac,mp3,ac3,eac3"
        VideoCodec:      "h264"
        Protocol:        "http"
        EstimateContentLength: false
        Context:         "Streaming"
        MaxAudioChannels: 6
        TranscodeSeekInfo: "Auto"
        CopyTimestamps:  false
    })
    
    return profiles
end function

' Get codec profiles for conditional codec restrictions
function GetCodecProfiles() as Object
    profiles = []
    
    ' H264 level/profile restrictions
    h264Conditions = []
    h264Conditions.Push({
        Condition:       "NotEquals"
        Property:        "VideoProfile"
        Value:           "high 10"
    })
    h264Conditions.Push({
        Condition:       "NotEquals"
        Property:        "VideoProfile"
        Value:           "high 4:2:2"
    })
    h264Conditions.Push({
        Condition:       "NotEquals"
        Property:        "VideoProfile"
        Value:           "high 4:4:4"
    })
    
    profiles.Push({
        Type:            "Video"
        Codec:           "h264"
        Conditions:      h264Conditions
    })
    
    ' AAC profile restrictions
    profiles.Push({
        Type:            "VideoAudio"
        Codec:           "aac"
        Conditions:      []
    })
    
    return profiles
end function

' Get subtitle profiles supported by Roku
function GetSubtitleProfiles() as Object
    profiles = []
    
    ' SRT - externally loaded
    profiles.Push({
        Format:    "srt"
        Method:    "External"
    })
    
    ' SRT - burn in (for transcoding)
    profiles.Push({
        Format:    "srt"
        Method:    "Encode"
    })
    
    ' SSA/ASS - burn in required
    profiles.Push({
        Format:    "ssa"
        Method:    "Encode"
    })
    profiles.Push({
        Format:    "ass"
        Method:    "Encode"
    })
    
    ' VTT - external
    profiles.Push({
        Format:    "vtt"
        Method:    "External"
    })
    
    ' SUBRIP - external
    profiles.Push({
        Format:    "subrip"
        Method:    "External"
    })
    
    ' PGS/HDMV PGS - burn in
    profiles.Push({
        Format:    "pgssub"
        Method:    "Encode"
    })
    
    ' DVD subtitles - burn in
    profiles.Push({
        Format:    "dvdsub"
        Method:    "Encode"
    })
    
    return profiles
end function
