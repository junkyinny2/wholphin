<?xml version="1.0" encoding="utf-8" ?>
<component name="HomeScene" extends="Scene">
    <script type="text/brightscript" uri="pkg:/components/HomeScene.brs" />
    <script type="text/brightscript" uri="pkg:/components/HomeSceneFocus.brs" />

    <children>

        <!-- ===================== HERO BACKDROP ===================== -->
        <Poster
            id="heroBackdrop"
            width="1920"
            height="1080"
            translation="[0,0]"
            loadDisplayMode="scaleToFill"
        />

        <!-- Pre-rendered gradient PNG: transparent (right) -> black (left),
             and transparent (top) -> black (bottom). Ship this asset yourself,
             or fake it with stacked semi-opaque Rectangles (see note at bottom). -->
        <Poster
            id="heroGradient"
            width="1920"
            height="1080"
            translation="[0,0]"
            uri="pkg:/images/hero_gradient.png"
        />

        <!-- ===================== HERO TEXT BLOCK ===================== -->
        <Label
            id="heroTitle"
            translation="[140, 160]"
            width="900"
            font="font:LargeBoldSystemFont"
            color="0xFFFFFFFF"
        />

        <Label
            id="heroSubtitle"
            translation="[140, 230]"
            width="900"
            font="font:MediumSystemFont"
            color="0xE0E0E0FF"
        />

        <Label
            id="heroMeta"
            translation="[140, 270]"
            width="900"
            font="font:SmallSystemFont"
            color="0xB0B0B0FF"
        />

        <Label
            id="heroDescription"
            translation="[140, 310]"
            width="800"
            height="90"
            wrap="true"
            numLines="3"
            ellipsisText="..."
            font="font:SmallSystemFont"
            color="0xCCCCCCFF"
        />

        <!-- Play / More Info buttons -->
        <Group id="heroButtons" translation="[140, 410]">
            <Rectangle id="playBtnBg" width="140" height="50" color="0x14B4E8FF" />
            <Label id="playBtnLabel" text="Play" translation="[45, 14]" color="0x000000FF" font="font:MediumBoldSystemFont" />

            <Rectangle id="infoBtnBg" translation="[156,0]" width="180" height="50" color="0x33333380" />
            <Label id="infoBtnLabel" text="More Info" translation="[196, 14]" color="0xFFFFFFFF" font="font:MediumBoldSystemFont" />
        </Group>

        <!-- Clock, top right -->
        <Label
            id="clockLabel"
            translation="[1780, 40]"
            font="font:MediumSystemFont"
            color="0xFFFFFFFF"
            horizAlign="right"
        />

        <!-- ===================== LEFT NAV RAIL ===================== -->
        <NavRail
            id="navRail"
            translation="[0,0]"
        />

        <!-- ===================== CONTENT ROWS ===================== -->
        <!-- A "grid of RowLists" -- each row is its own RowList, stacked vertically.
             rowItemSize differs per row (16:9 for "Next Up" episodes vs 2:3 for posters). -->
        <RowList
            id="contentRows"
            translation="[140, 560]"
            itemComponentName="RowListItem"
            rowItemSize="[[300,170],[160,240],[160,240],[160,240]]"
            rowItemSpacing="[[24,0],[24,0],[24,0],[24,0]]"
            rowLabelOffset="[[0,0],[0,0],[0,0],[0,0]]"
            rowHeights="[220,280,280,280]"
            showRowLabel="[true,true,true,true]"
            numRows="4"
            focusBitmapUri="pkg:/images/focus_ring.9.png"
        />

    </children>
</component>
